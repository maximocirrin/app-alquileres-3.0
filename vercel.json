{
  "version": 2,
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self \"https://didit.me\" \"https://*.didit.me\"), microphone=(self \"https://didit.me\" \"https://*.didit.me\"), geolocation=(self), payment=(), usb=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.tailwindcss.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://unpkg.com https://www.googletagmanager.com https://maps.googleapis.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://*.supabase.co https://verification.didit.me https://api.didit.me https://maps.googleapis.com https://*.googleapis.com https://api.bcra.gob.ar; frame-src https://didit.me https://*.didit.me; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/og-image.png",
      "destination": "/img/og-vivat.png"
    },
    {
      "source": "/og-vivat.png",
      "destination": "/img/og-vivat.png"
    },
    {
      "source": "/api/firmas/:action*",
      "destination": "/api/firmas?action=:action*"
    },
    {
      "source": "/api/contracts/:path*",
      "destination": "/api/firmas?route=contracts&path=:path*"
    },
    {
      "source": "/api/inventario-upload",
      "destination": "/api/inventario?action=upload"
    },
    {
      "source": "/api/garante-portal",
      "destination": "/api/garantes?portal=1"
    },
    {
      "source": "/contract",
      "destination": "/contract.html"
    },
    {
      "source": "/contratos",
      "destination": "/contratos.html"
    },
    {
      "source": "/contrato",
      "destination": "/contratos.html"
    }
  ]
}
