# Public Supabase configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_publishable_key

# Server only; never expose these values to browser code
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
APP_URL=https://vivat.com.ar
PUBLIC_APP_URL=https://vivat.com.ar
ALLOWED_ORIGINS=https://vivat.com.ar,https://www.vivat.com.ar

# Didit identity and contract-signature workflows must be separate
DIDIT_API_KEY=your_didit_api_key
DIDIT_WORKFLOW_ID=your_full_identity_workflow_id
# Signing requires a KYC workflow with document, liveness and face match.
# The signer submits new evidence directly to Didit; existing portraits are not exported.
DIDIT_WORKFLOW_ID_SIGNATURE=your_signature_full_kyc_workflow_id
DIDIT_WEBHOOK_SECRET=your_identity_webhook_shared_secret
DIDIT_SIGNATURE_WEBHOOK_SECRET=your_signature_webhook_shared_secret

# Trusted timestamp authority
TSA_SERVER_URL=https://your-tsa-gateway.example/api/timestamp
TSA_SERVER_API_KEY=your_tsa_gateway_key

# Optional provider gateways
ARCA_PADRON_GATEWAY_URL=https://your-arca-gateway.example/api/padron
ARCA_PADRON_GATEWAY_TOKEN=your_arca_gateway_token
BCRA_API_URL=https://api.bcra.gob.ar/centraldedeudores/v1.0/Deudas
GOOGLE_MAPS_API_KEY=your_restricted_google_maps_key

# Transactional notification emails (Supabase Edge Function)
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=Vivat <notificaciones@vivat.com.ar>
RESEND_REPLY_TO=soporte@vivat.com.ar
EMAIL_LOGO_URL=https://vivat.com.ar/img/logo-lite.png
NOTIFICATION_EMAIL_WEBHOOK_SECRET=generate_a_long_random_secret
